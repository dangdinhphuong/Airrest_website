{
  "name": "@airrest/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Base Node.js (TypeScript + Express + PostgreSQL (Supabase) + Socket.io) cho Airrest BE API",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env api/server.ts",
    "start": "node --env-file-if-exists=.env --import tsx api/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "RUN_DB_TESTS=1 vitest run",
    "storage:check": "tsx --env-file-if-exists=.env scripts/storage-check.ts",
    "db:seed": "tsx --env-file-if-exists=.env database/scripts/seed.ts",
    "db:migrate": "tsx --env-file-if-exists=.env database/scripts/migrate.ts",
    "dev:db": "tsx scripts/dev-db.ts"
  },
  "dependencies": {
    "@airrest/business-logic": "*",
    "@airrest/shared-types": "*",
    "@airrest/utils": "*",
    "@airrest/validation": "*",
    "@aws-sdk/client-s3": "^3.1166.0",
    "@aws-sdk/s3-request-presigner": "^3.1166.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.23.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "embedded-postgres": "^18.6.0-beta.19",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
