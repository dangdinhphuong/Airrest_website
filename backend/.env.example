NODE_ENV=development
PORT=3000
# Postgres. Supabase: Project Settings -> Database -> Connection string -> "Session pooler" (port 5432, chạy được trên mạng chỉ có IPv4).
# Dạng: postgres://postgres.<project-ref>:<DB-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Đây là mật khẩu DATABASE (đặt ở Database settings), KHÔNG phải SUPABASE_SECRET_KEY. Local: postgres://postgres:postgres@localhost:5432/airrest
DATABASE_URL=postgres://postgres:postgres@localhost:5432/airrest
#DATABASE_SSL=auto          # auto = bật TLS trừ khi host là localhost
#DATABASE_POOL_MAX=10
# Đổi bằng chuỗi ngẫu nhiên >= 32 ký tự ở mọi môi trường thật
JWT_SECRET=dev-only-change-me-please-0123456789
# Khóa mã hóa trường nhạy cảm (tài khoản nhận tiền). Đổi ở mọi môi trường thật; mất khóa = mất dữ liệu đã mã hóa.
DATA_ENC_KEY=dev-only-data-key-change-me-0123456789
JWT_EXPIRES_IN=1h
GUEST_TOKEN_EXPIRES_IN=30m
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# --- Cloudflare R2 (media) --- R2 -> Manage API tokens (Object Read & Write cho đúng bucket)
#R2_ACCOUNT_ID=
#R2_ACCESS_KEY_ID=
#R2_SECRET_ACCESS_KEY=
#R2_BUCKET=
#R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
# --- VNPay ---
# false: đặt phòng với paymentMethod=VNPAY bị từ chối (409 VNPAY_DISABLED)
VNPAY_ENABLED=true
# mock = cổng giả lập cục bộ (không cần khóa); live = gọi VNPay thật, khi đó bắt buộc VNPAY_TMN_CODE + VNPAY_HASH_SECRET
VNPAY_MODE=mock
#VNPAY_TMN_CODE=
#VNPAY_HASH_SECRET=
# Mặc định là sandbox. Production: https://pay.vnpay.vn/vpcpay.html và https://pay.vnpay.vn/merchant_webapi/api/transaction
#VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
#VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://localhost:5174/payment/result
# IPN URL khai báo trên cổng VNPay merchant (không gửi trong request): https://<api>/v1/payments/vnpay/ipn
# Mật khẩu tài khoản mẫu khi chạy npm run db:seed
SEED_PASSWORD=ChangeMe123!
