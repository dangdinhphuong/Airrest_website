NODE_ENV=development
PORT=3000
# Postgres. Supabase: Project Settings -> Database -> Connection string -> "Session pooler" (port 5432, chạy được trên mạng chỉ có IPv4).
# Dạng: postgres://postgres.<project-ref>:<DB-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Đây là mật khẩu DATABASE (đặt ở Database settings), KHÔNG phải SUPABASE_SECRET_KEY. Local: postgres://postgres:postgres@localhost:5432/airrest
DATABASE_URL=postgres://postgres:postgres@localhost:5432/airrest
#DATABASE_SSL=auto          # auto = bật TLS trừ khi host là localhost
#DATABASE_POOL_MAX=10
# Đổi bằng chuỗi ngẫu nhiên >= 32 ký tự ở mọi môi trường thật
JWT_SECRET=dev-only-change-me-please-0123456789
# Khóa mã hóa trường nhạy cảm (tài khoản nhận tiền). Đổi ở mọi môi trường thật; mất khóa = mất dữ liệu đã mã hóa.
DATA_ENC_KEY=dev-only-data-key-change-me-0123456789
JWT_EXPIRES_IN=1h
GUEST_TOKEN_EXPIRES_IN=2h
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# --- Cloudflare R2 (media) --- R2 -> Manage API tokens (Object Read & Write cho đúng bucket)
#R2_ACCOUNT_ID=
#R2_ACCESS_KEY_ID=
#R2_SECRET_ACCESS_KEY=
#R2_BUCKET=
#R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
# --- VNPay ---
# false: đặt phòng với paymentMethod=VNPAY bị từ chối (409 VNPAY_DISABLED)
VNPAY_ENABLED=true
# mock = cổng giả lập cục bộ (không cần khóa); live = gọi VNPay thật, khi đó bắt buộc VNPAY_TMN_CODE + VNPAY_HASH_SECRET
VNPAY_MODE=mock
#VNPAY_TMN_CODE=
#VNPAY_HASH_SECRET=
# Mặc định là sandbox. Production: https://pay.vnpay.vn/vpcpay.html và https://pay.vnpay.vn/merchant_webapi/api/transaction
#VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
#VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://localhost:5174/payment/result
# IPN URL khai báo trên cổng VNPay merchant (không gửi trong request): https://<api>/v1/payments/vnpay/ipn
# --- MoMo ---
# false: đặt phòng với paymentMethod=MOMO bị từ chối (409 MOMO_DISABLED)
MOMO_ENABLED=false
# mock = giả lập cục bộ (khóa sandbox công khai, không gọi mạng; production cấm bật MOMO_ENABLED với mock); live = gọi MOMO_ENDPOINT, bắt buộc 3 khóa dưới
MOMO_MODE=mock
#MOMO_PARTNER_CODE=
#MOMO_ACCESS_KEY=
#MOMO_SECRET_KEY=
# Mặc định là sandbox. Production: https://payment.momo.vn
#MOMO_ENDPOINT=https://test-payment.momo.vn
# Trang FE đưa khách về sau khi thanh toán
MOMO_RETURN_URL=http://localhost:5174/payment/result
# API công khai MoMo gọi POST JSON (gửi trong request tạo link), phải truy cập được từ internet khi live
MOMO_IPN_URL=http://localhost:3000/v1/payments/momo/ipn
# --- Xe đưa đón có điều phối ---
# Chu kỳ quét điều phối (giây), 0 = tắt. Điều phối khi còn <= LEAD phút tới giờ đón; xe bận nếu lệch giờ < WINDOW phút; NEEDS_EXTERNAL quá hạn khi còn <= OVERDUE phút; "gọi xe ngay" = bây giờ + CALL_NOW phút
SHUTTLE_DISPATCH_SWEEP_SEC=60
SHUTTLE_DISPATCH_LEAD_MIN=30
SHUTTLE_VEHICLE_WINDOW_MIN=90
SHUTTLE_EXTERNAL_OVERDUE_MIN=10
SHUTTLE_CALL_NOW_MIN=15
# Mô phỏng vị trí xe (chỉ chuyến của khách sạn). SIM_AUTO: tự đổi trạng thái để demo (mặc định bật ngoài production, tắt ở production; bỏ trống = theo mặc định).
# SIM_AUTO còn tự đặt + tự chạy xe ngoài GIẢ (liên kết DEMO, cờ simulated); NODE_ENV=production + SIM_AUTO=true -> từ chối khởi động.
# TIME_SCALE > 1: tua nhanh demo. OSRM_URL: máy chủ định tuyến (lỗi/timeout 5s -> đường thẳng).
SHUTTLE_SIM_ENABLED=true
SHUTTLE_SIM_AUTO=
SHUTTLE_SIM_SPEED_KMH=40
SHUTTLE_SIM_TIME_SCALE=1
SHUTTLE_SIM_TICK_MS=2000
OSRM_URL=https://router.project-osrm.org
# Tên miền cho phép của liên kết chia sẻ chuyến xe ngoài (phân tách dấu phẩy, khớp hậu tố theo nhãn). Mặc định là phỏng đoán:
# PHẢI kiểm tra tên miền chia sẻ thực tế của Grab và Xanh SM trước khi chạy thật.
EXTERNAL_RIDE_LINK_HOSTS=grab.com,xanhsm.com
# Mật khẩu tài khoản mẫu khi chạy npm run db:seed
SEED_PASSWORD=ChangeMe123!
