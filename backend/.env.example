NODE_ENV=development
PORT=3000
# Postgres. Supabase: Project Settings -> Database -> Connection string -> "Session pooler" (port 5432, chạy được trên mạng chỉ có IPv4).
# Dạng: postgres://postgres.<project-ref>:<DB-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Đây là mật khẩu DATABASE (đặt ở Database settings), KHÔNG phải SUPABASE_SECRET_KEY. Local: postgres://postgres:postgres@localhost:5432/airrest
DATABASE_URL=postgres://postgres:postgres@localhost:5432/airrest
#DATABASE_SSL=auto          # auto = bật TLS trừ khi host là localhost
#DATABASE_POOL_MAX=10
# Đổi bằng chuỗi ngẫu nhiên >= 32 ký tự ở mọi môi trường thật
JWT_SECRET=dev-only-change-me-please-0123456789
# Khóa mã hóa trường nhạy cảm (tài khoản nhận tiền). Đổi ở mọi môi trường thật; mất khóa = mất dữ liệu đã mã hóa.
DATA_ENC_KEY=dev-only-data-key-change-me-0123456789
JWT_EXPIRES_IN=1h
GUEST_TOKEN_EXPIRES_IN=2h
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# --- Cloudflare R2 (media) --- R2 -> Manage API tokens (Object Read & Write cho đúng bucket)
#R2_ACCOUNT_ID=
#R2_ACCESS_KEY_ID=
#R2_SECRET_ACCESS_KEY=
#R2_BUCKET=
#R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
# --- SePay (cổng thanh toán). false: đặt phòng với paymentMethod=SEPAY bị từ chối (409 SEPAY_DISABLED)
SEPAY_ENABLED=false
# mock = giả lập cục bộ (không gọi mạng; production cấm bật SEPAY_ENABLED với mock); live = chuyển khách sang SePay thật
SEPAY_MODE=mock
#SEPAY_MERCHANT_ID=
# Khóa merchant: ký form checkout
#SEPAY_SECRET_KEY=
# Khóa IPN (KHÁC khóa merchant): đặt cùng giá trị ở SePay > Cổng thanh toán > Cấu hình > IPN (xác thực SECRET_KEY); bắt buộc khi live
#SEPAY_IPN_SECRET=
#SEPAY_CHECKOUT_URL=https://pay.sepay.vn/v1/checkout/init
SEPAY_RETURN_URL=http://localhost:5174/payment/result
# URL công khai SePay gọi (khai báo URL này ở SePay). Origin của nó cũng phục vụ trang chuyển hướng checkout
SEPAY_IPN_URL=http://localhost:3000/v1/payments/sepay/ipn
# --- Trợ lý chat AI local (Ollama). Mặc định tắt. Bật: AI_CHAT_ENABLED=true và chạy Ollama cùng máy (ai-local/). Lỗi/quá hạn thì chatbot dùng bản từ khóa.
#AI_CHAT_ENABLED=false
#OLLAMA_URL=http://127.0.0.1:11434
#OLLAMA_MODEL=qwen2.5:3b-instruct
#AI_CHAT_TIMEOUT_MS=15000
