{
  "name": "airrest",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @airrest/web",
    "dev:api": "npm run dev -w @airrest/backend",
    "build:web": "npm run build -w @airrest/web",
    "typecheck": "npm run typecheck -w @airrest/backend",
    "test": "npm test -w @airrest/backend",
    "test:db": "npm run test:db -w @airrest/backend",
    "db:seed": "npm run db:seed -w @airrest/backend",
    "dev:db": "npm run dev:db -w @airrest/backend"
  }
}
